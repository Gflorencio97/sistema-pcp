# Copie para backend/.env (esse arquivo NAO vai para o git).
# Todas as variaveis sao opcionais: o que faltar usa o padrao.

# 'producao' desliga /docs, /redoc e /openapi.json e nao libera CORS.
PCP_AMBIENTE=desenvolvimento

# Chave do login (JWT). Se faltar, o sistema gera uma aleatoria e grava neste arquivo.
# Nunca use um valor de exemplo. Para gerar uma: python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECRET_KEY=

# Senha do usuario 'admin' criado na primeira execucao (sem usuarios no banco).
# Se faltar, e gerada e escrita UMA vez no servidor.log. A troca e obrigatoria no primeiro acesso.
# PCP_ADMIN_SENHA=

# Validade do login em minutos (480 = 8 horas, um turno).
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Outro banco (padrao: SQLite em backend/pcp.db)
# DATABASE_URL=sqlite:///C:/PCP-Evoluttion/backend/pcp.db
